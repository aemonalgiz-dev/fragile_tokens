# Credentials and node access -- never commit
.lambda_key
.lambda_key.*
lambda_details*.txt
*.pem
id_ed25519*

# Environments, caches, editors
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.idea/
.vscode/

# Large research artifacts kept outside version control.
# The raw fragility tensors (up to 3.7 GB each) and the sampled embedding tables
# are regenerated by src/cut/fragility.py and scratch/emb_sample.py; the compact
# matrices in results/compact/ are committed and are what the figures and the
# paper's numbers are read from.
results/*.pt
results/*.npz
data/
runs/
scratch/*.tgz

# Local build products of the paper pipeline
arxiv/main.aux
arxiv/main.log
arxiv/main.out
arxiv/main.xdv
arxiv/body_pre.md

outdated_results/*.pt
outdated_results/*.npz
